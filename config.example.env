# Raphael bot settings.
# 1) Copy this file and rename the copy to:  .env
# 2) Fill in the blanks below. Never share the .env file or post it anywhere.

# --- Secrets (paste your own, keep private) ---
DISCORD_TOKEN=
TRACKER_API_KEY=

# --- Your server (right-click the server icon > Copy Server ID) ---
GUILD_ID=

# --- Channels (right-click a channel > Copy Channel ID) ---
# Where role-check reports go. Suggested: #executive-chat
LOG_CHANNEL_ID=
# Where "RANK UP!" and weekly Biggest Grower posts go. Suggested: #main-chat
SHOUTOUT_CHANNEL_ID=

# --- Alliance ---
GAME_SERVER=369
ALLIANCE_TAG=JTF

# --- Safety switch ---
# true  = only REPORT what it would change (start here!)
# false = actually change roles
DRY_RUN=true

# --- Might cutoffs (raw numbers) ---
ARCH_MIN=22000000
GREATER_MIN=16000000

# --- Named Monsters & grandfathered members ---
# Members with this role never drop below Greater Demon
NAMED_MONSTER_ROLE=Named Monster
# Discord USERNAMES (not nicknames) that always keep Arch Demon, comma separated
GRANDFATHER_ARCH=

# If true, a Goblin/Wanderer whose nickname matches the roster is verified automatically.
# Leave false so a Primordial still checks them in-game first.
AUTO_VERIFY=false

# --- Timing ---
CHECK_MINUTES=60
TIMEZONE=America/Chicago
# Weekly Biggest Grower post: 0=Monday ... 6=Sunday, hour in 24h time
WEEKLY_DAY=0
WEEKLY_HOUR=10
